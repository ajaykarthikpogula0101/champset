# ChampSet PRODUCTION env. Copy to `.env` on the server and fill in.
# Used by docker-compose.prod.yml. Never commit the filled-in version.

# --- Domain / TLS ---
# Your apex domain. The app lives at app.<DOMAIN>, API at api.<DOMAIN>,
# Convex at convex.<DOMAIN> and convex-site.<DOMAIN>. Point all four A records
# at the server IP before bringing Caddy up.
DOMAIN=champset.example.com
ACME_EMAIL=ops@championsmail.com

# --- Database ---
POSTGRES_USER=champset
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=champset_internal

# --- OpenRouter (the ONLY paid dependency) ---
OPENROUTER_API_KEY=sk-or-v1-...
SCHEMA_INFERENCE_MODEL=anthropic/claude-sonnet-4.6
POPULATE_ORCHESTRATOR_MODEL=qwen/qwen3.7-max
INVESTIGATE_SUBAGENT_MODEL=qwen/qwen3.7-max

# --- Clerk PRODUCTION instance ---
# Dev/keyless will NOT work on a real domain. In the Clerk dashboard create a
# production instance, add your domain, and create the "convex" JWT template
# (audience = convex). Then paste the live keys + issuer here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_JWT_ISSUER_DOMAIN=https://your-prod.clerk.accounts.dev

# --- Convex self-hosted admin key ---
# Leave BLANK on first deploy; generated during bootstrap (see DEPLOY.md step 4).
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- Optional ---
RESEND_API_KEY=
EMAIL_FROM=ChampSet <noreply@championsmail.com>

# ---- Web discovery engine (A/B toggle) ----
SEARCH_PROVIDER=searxng
EXA_API_KEY=

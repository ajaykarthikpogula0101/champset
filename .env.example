# This is the only local env file ChampSet expects.
# Copy this file to .env and fill in your values.

# Web search + page fetch is handled by a self-hosted, open-source backend:
#   - SearXNG (metasearch — Google/Bing/DuckDuckGo/Brave) for search_web
#   - HTTP fetch + Mozilla Readability for fetch_page
# No API key required. SearXNG runs as a Docker service (see docker-compose.dev.yml).
# Override only if you point at an external SearXNG instance.
SEARXNG_URL=http://searxng:8080

# ---- Web discovery engine (A/B toggle) ----
# Which engine the agents use for web search + page fetch:
#   searxng = owned SearXNG metasearch + Readability (no key)  [default]
#   exa     = Exa /search + /contents (needs EXA_API_KEY)
# App-wide default; the dashboard toggle (per-user) and a per-Set choice override it.
SEARCH_PROVIDER=searxng
# Exa API key - required only when the Exa engine is active. https://dashboard.exa.ai/api-keys
EXA_API_KEY=
# Optional Exa tuning:
# EXA_SEARCH_TYPE=auto      # auto | neural | keyword | fast
# EXA_NUM_RESULTS=10

# OpenRouter (required) — schema inference + AI agents.
# Generate at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-...

# OpenRouter model slugs for each AI task.
# Defaults (used when no user preference is saved):
#   SCHEMA_INFERENCE_MODEL:        anthropic/claude-sonnet-4.6  (powerful for schema inference)
#   POPULATE_ORCHESTRATOR_MODEL:   qwen/qwen3.7-max            (cost-effective orchestrator)
#   INVESTIGATE_SUBAGENT_MODEL:    qwen/qwen3.7-max            (cost-effective subagent)
# Find model IDs at https://openrouter.ai/models — any OpenRouter model slug is valid.
SCHEMA_INFERENCE_MODEL=anthropic/claude-sonnet-4.6
POPULATE_ORCHESTRATOR_MODEL=qwen/qwen3.7-max
INVESTIGATE_SUBAGENT_MODEL=qwen/qwen3.7-max

# Model used to grade each generated row's accuracy from token logprobs.
# Must return logprobs via OpenRouter (OpenAI models do; the chat defaults
# above may not). Scores appear in the dataset's "Accuracy Score" column.
ACCURACY_SCORING_MODEL=openai/gpt-4o-mini

# Admin allowlist. Comma-separated Clerk user ids allowed to edit the app-wide
# model config (and refresh the shared model catalog) from the dashboard.
# Everyone else sees model settings read-only. Empty locks editing for all.
# Example: ADMIN_USER_IDS=user_abc123,user_def456
ADMIN_USER_IDS=

# Clerk (required) — user authentication.
# Create a free app at https://dashboard.clerk.com
# Enable the Clerk JWT Templates -> Convex template, then set your issuer URL.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Auto-generated by `make dev` on first run. Do not fill in manually.
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Local service URLs
CLIENT_ORIGIN=http://localhost:3500
CONVEX_URL=http://localhost:3210
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
NEXT_PUBLIC_BACKEND_URL=http://localhost:3501
PORT=3501

# LakeStream — external blog scraper (discover blog articles + extract them).
# See https://github.com/Champ-Deep/LakeStream
# This value is for running the backend directly on the host. In Docker
# (`make dev`) the backend reaches a host-run LakeStream via
# host.docker.internal:3001; set LAKESTREAM_URL_DOCKER to override that.
LAKESTREAM_URL=http://localhost:3001
# API key (X-API-Key) used to fetch scrape results. Generate one in LakeStream
# (POST /api/api-keys). Without it, scrape runs can start but article rows
# cannot be imported.
LAKESTREAM_API_KEY=

# Optional — the following keys are not required to run BigSet.

# Resend (optional — transactional emails when a populate workflow finishes).
# Unset → email module logs and no-ops. Generate at https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="ChampSet <noreply@championsmail.com>"

# PostHog (optional — leave blank to disable analytics entirely in local dev).
# Get from https://us.posthog.com/project/settings/general.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
